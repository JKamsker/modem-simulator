<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="modem-simulator">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="profile" type="ProfileType" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="ProfileType">
    <xs:sequence>
      <xs:element name="identity" type="IdentityType" minOccurs="0"/>
      <xs:element name="dialect" type="DialectType"/>
      <xs:element name="error-policy" type="ErrorPolicyType" minOccurs="0"/>
      <xs:element name="initial-state" type="InitialStateType" minOccurs="0"/>
      <xs:element name="commands" type="CommandsType" minOccurs="0"/>
      <xs:element name="registers" type="RegistersType" minOccurs="0"/>
      <xs:element name="coverage" type="CoverageType" minOccurs="0"/>
      <xs:element name="deviations" type="DeviationsType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="id" type="ProfileIdType" use="required"/>
    <xs:attribute name="vendor" type="xs:string" use="required"/>
    <xs:attribute name="status" type="ProfileStatusType" use="required"/>
    <xs:attribute name="profileKind" type="ProfileKindType" use="optional" default="cellular"/>
    <xs:attribute name="extends" type="ProfileIdListType" use="optional"/>
    <xs:attribute name="modelFamily" type="xs:string" use="optional"/>
    <xs:attribute name="manualVersion" type="xs:string" use="optional"/>
    <xs:attribute name="manualDate" type="xs:date" use="optional"/>
  </xs:complexType>

  <xs:complexType name="IdentityType">
    <xs:attribute name="manufacturer" type="xs:string" use="required"/>
    <xs:attribute name="model" type="xs:string" use="required"/>
    <xs:attribute name="revision" type="xs:string" use="optional"/>
    <xs:attribute name="imei" type="ImeiType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="DialectType">
    <xs:attribute name="commandTerminator" type="TerminatorType" use="required"/>
    <xs:attribute name="responseTerminator" type="TerminatorType" use="required"/>
    <xs:attribute name="smsPromptBytes" type="HexBytesType" use="optional"/>
    <xs:attribute name="defaultEcho" type="xs:boolean" use="optional"/>
    <xs:attribute name="defaultVerbose" type="xs:boolean" use="optional"/>
    <xs:attribute name="defaultQuiet" type="xs:boolean" use="optional"/>
    <xs:attribute name="resetPolicy" type="ResetPolicyType" use="optional"/>
    <xs:attribute name="lineModel" type="LineModelType" use="optional"/>
    <xs:attribute name="unknownAtCommand" type="UnknownAtCommandPolicyType" use="optional" default="ERROR"/>
    <xs:attribute name="extendedPrefixes" type="xs:string" use="optional" default="+ % # !"/>
  </xs:complexType>

  <xs:complexType name="ErrorPolicyType">
    <xs:attribute name="invalidParameter" type="InvalidParameterPolicyType" use="optional" default="CME_OR_ERROR"/>
    <xs:attribute name="stateFailure" type="StateFailurePolicyType" use="optional" default="CME"/>
    <xs:attribute name="smsFailure" type="SmsFailurePolicyType" use="optional" default="CMS"/>
    <xs:attribute name="timeout" type="TimeoutPolicyType" use="optional" default="NO_RESPONSE"/>
  </xs:complexType>

  <xs:complexType name="InitialStateType">
    <xs:sequence>
      <xs:element name="sim" type="SimType" minOccurs="0"/>
      <xs:element name="network" type="NetworkType" minOccurs="0"/>
      <xs:element name="signal" type="SignalType" minOccurs="0"/>
      <xs:element name="sms" type="SmsType" minOccurs="0"/>
      <xs:element name="call" type="CallType" minOccurs="0"/>
      <xs:element name="modem" type="ModemRuntimeType" minOccurs="0"/>
      <xs:element name="modem-lines" type="ModemLinesType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SimType">
    <xs:attribute name="state" type="SimStateType" use="optional"/>
    <xs:attribute name="pinQueryEnabled" type="xs:boolean" use="optional"/>
    <xs:attribute name="pin" type="PinType" use="optional"/>
    <xs:attribute name="pinRef" type="xs:string" use="optional"/>
    <xs:attribute name="puk" type="PukType" use="optional"/>
    <xs:attribute name="pukRef" type="xs:string" use="optional"/>
    <xs:attribute name="pinRetries" type="RetryCounterType" use="optional"/>
    <xs:attribute name="pukRetries" type="RetryCounterType" use="optional"/>
    <xs:attribute name="imsi" type="ImsiType" use="optional"/>
    <xs:attribute name="iccid" type="IccidType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="NetworkType">
    <xs:sequence>
      <xs:element name="operator" type="OperatorType" minOccurs="0"/>
      <xs:element name="sms-rate-limit" type="SmsRateLimitType" minOccurs="0"/>
      <xs:element name="delays" type="NetworkDelaysType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="cregN" type="CregModeType" use="required"/>
    <xs:attribute name="stat" type="NetworkStatType" use="required"/>
    <xs:attribute name="lac" type="HexCellType" use="optional"/>
    <xs:attribute name="ci" type="HexCellType" use="optional"/>
    <xs:attribute name="act" type="AccessTechnologyType" use="optional"/>
    <xs:attribute name="rejectCause" type="xs:nonNegativeInteger" use="optional"/>
    <xs:attribute name="rejectCauseType" type="xs:nonNegativeInteger" use="optional"/>
  </xs:complexType>

  <xs:complexType name="OperatorType">
    <xs:attribute name="selectionMode" type="OperatorSelectionModeType" use="required"/>
    <xs:attribute name="format" type="OperatorFormatType" use="required"/>
    <xs:attribute name="longName" type="xs:string" use="optional"/>
    <xs:attribute name="shortName" type="xs:string" use="optional"/>
    <xs:attribute name="numeric" type="OperatorNumericType" use="required"/>
    <xs:attribute name="mcc" type="MccType" use="required"/>
    <xs:attribute name="mnc" type="MncType" use="required"/>
  </xs:complexType>

  <xs:complexType name="SmsRateLimitType">
    <xs:attribute name="maxMessages" type="PositiveCounterType" use="required"/>
    <xs:attribute name="windowSeconds" type="PositiveCounterType" use="required"/>
    <xs:attribute name="scope" type="SmsRateLimitScopeType" use="required"/>
    <xs:attribute name="rejectCmsError" type="CmsErrorType" use="required"/>
  </xs:complexType>

  <xs:complexType name="NetworkDelaysType">
    <xs:sequence>
      <xs:element name="delay" type="NetworkDelayType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="NetworkDelayType">
    <xs:attribute name="operation" type="NetworkDelayOperationType" use="required"/>
    <xs:attribute name="minMs" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="maxMs" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="SignalType">
    <xs:attribute name="rssi" type="CsqRssiType" use="required"/>
    <xs:attribute name="ber" type="CsqBerType" use="required"/>
  </xs:complexType>

  <xs:complexType name="SmsType">
    <xs:attribute name="textMode" type="xs:boolean" use="optional"/>
    <xs:attribute name="smsc" type="xs:string" use="optional"/>
    <xs:attribute name="storage" type="SmsStorageType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="CallType">
    <xs:attribute name="mode" type="CallModeType" use="optional" default="command"/>
    <xs:attribute name="carrier" type="xs:boolean" use="optional" default="false"/>
    <xs:attribute name="dialedNumber" type="xs:string" use="optional"/>
    <xs:attribute name="incomingNumber" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="ModemRuntimeType">
    <xs:attribute name="lifecycle" type="ModemLifecycleType" use="optional" default="READY"/>
    <xs:attribute name="freezeMode" type="FreezeModeType" use="optional" default="NONE"/>
    <xs:attribute name="bootDelayMs" type="xs:nonNegativeInteger" use="optional" default="0"/>
  </xs:complexType>

  <xs:complexType name="ModemLinesType">
    <xs:attribute name="dtr" type="xs:boolean" use="optional"/>
    <xs:attribute name="dsr" type="xs:boolean" use="optional"/>
    <xs:attribute name="dcd" type="xs:boolean" use="optional"/>
    <xs:attribute name="ri" type="xs:boolean" use="optional"/>
    <xs:attribute name="rts" type="xs:boolean" use="optional"/>
    <xs:attribute name="cts" type="xs:boolean" use="optional"/>
  </xs:complexType>

  <xs:complexType name="CommandsType">
    <xs:sequence>
      <xs:element name="command" type="CommandDeclarationType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="CommandDeclarationType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="status" type="CoverageStatusType" use="required"/>
    <xs:attribute name="handler" type="xs:string" use="optional"/>
    <xs:attribute name="reason" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="RegistersType">
    <xs:sequence>
      <xs:element name="register" type="RegisterDeclarationType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RegisterDeclarationType">
    <xs:attribute name="name" type="RegisterNameType" use="required"/>
    <xs:attribute name="default" type="xs:integer" use="required"/>
    <xs:attribute name="min" type="xs:integer" use="optional"/>
    <xs:attribute name="max" type="xs:integer" use="optional"/>
    <xs:attribute name="writable" type="xs:boolean" use="optional" default="true"/>
    <xs:attribute name="persistent" type="xs:boolean" use="optional" default="false"/>
  </xs:complexType>

  <xs:complexType name="CoverageType">
    <xs:sequence>
      <xs:element name="command" type="CommandDeclarationType" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="source" type="xs:string" use="required"/>
    <xs:attribute name="commandsTotal" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="unknown" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="DeviationsType">
    <xs:sequence>
      <xs:element name="deviation" maxOccurs="unbounded">
        <xs:complexType>
          <xs:simpleContent>
            <xs:extension base="xs:string">
              <xs:attribute name="id" type="xs:string" use="required"/>
              <xs:attribute name="severity" type="DeviationSeverityType" use="optional"/>
            </xs:extension>
          </xs:simpleContent>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:simpleType name="ProfileIdType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9._:-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ProfileIdListType">
    <xs:list itemType="ProfileIdType"/>
  </xs:simpleType>

  <xs:simpleType name="ProfileStatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="normative-base"/>
      <xs:enumeration value="manufacturer-base"/>
      <xs:enumeration value="device-family"/>
      <xs:enumeration value="device-target"/>
      <xs:enumeration value="candidate"/>
      <xs:enumeration value="out-of-scope"/>
      <xs:enumeration value="stub"/>
      <xs:enumeration value="verified"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ProfileKindType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="base"/>
      <xs:enumeration value="cellular"/>
      <xs:enumeration value="pstn"/>
      <xs:enumeration value="isdn"/>
      <xs:enumeration value="hybrid"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TerminatorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CR"/>
      <xs:enumeration value="LF"/>
      <xs:enumeration value="CRLF"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HexBytesType">
    <xs:restriction base="xs:string">
      <xs:pattern value="([0-9A-Fa-f]{2})*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ResetPolicyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="factory-on-atz"/>
      <xs:enumeration value="nvram-on-atz"/>
      <xs:enumeration value="profile-default-on-atz"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="LineModelType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="byte-only"/>
      <xs:enumeration value="minimal-v250"/>
      <xs:enumeration value="profile-specific"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="UnknownAtCommandPolicyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="OK"/>
      <xs:enumeration value="ERR"/>
      <xs:enumeration value="ERROR"/>
      <xs:enumeration value="restart"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="InvalidParameterPolicyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ERROR"/>
      <xs:enumeration value="CME"/>
      <xs:enumeration value="CME_OR_ERROR"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StateFailurePolicyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ERROR"/>
      <xs:enumeration value="CME"/>
      <xs:enumeration value="NO_RESPONSE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SmsFailurePolicyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ERROR"/>
      <xs:enumeration value="CMS"/>
      <xs:enumeration value="NO_RESPONSE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TimeoutPolicyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ERROR"/>
      <xs:enumeration value="NO_RESPONSE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SimStateType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="READY"/>
      <xs:enumeration value="SIM_NOT_INSERTED"/>
      <xs:enumeration value="SIM_PIN_REQUIRED"/>
      <xs:enumeration value="SIM_PUK_REQUIRED"/>
      <xs:enumeration value="SIM_FAILURE"/>
      <xs:enumeration value="SIM_BUSY"/>
      <xs:enumeration value="SIM_WRONG"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PinType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4,8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PukType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RetryCounterType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PositiveCounterType">
    <xs:restriction base="xs:positiveInteger"/>
  </xs:simpleType>

  <xs:simpleType name="ImsiType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{14,15}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IccidType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{18,22}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ImeiType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{14,17}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CregModeType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NetworkStatType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="11"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HexCellType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9A-Fa-f]{1,8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AccessTechnologyType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="13"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OperatorSelectionModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="automatic"/>
      <xs:enumeration value="manual"/>
      <xs:enumeration value="deregister"/>
      <xs:enumeration value="set-format"/>
      <xs:enumeration value="manual-automatic"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OperatorFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="long"/>
      <xs:enumeration value="short"/>
      <xs:enumeration value="numeric"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SmsRateLimitScopeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="session"/>
      <xs:enumeration value="recipient"/>
      <xs:enumeration value="operator"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NetworkDelayOperationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sms-submit"/>
      <xs:enumeration value="dial"/>
      <xs:enumeration value="network-registration"/>
      <xs:enumeration value="operator-read"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CmsErrorType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="999"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OperatorNumericType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{5,6}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MccType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MncType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{2,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CsqRssiKnownType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="31"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CsqBerKnownType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="7"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CsqUnknownType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:enumeration value="99"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CsqRssiType">
    <xs:union memberTypes="CsqRssiKnownType CsqUnknownType"/>
  </xs:simpleType>

  <xs:simpleType name="CsqBerType">
    <xs:union memberTypes="CsqBerKnownType CsqUnknownType"/>
  </xs:simpleType>

  <xs:simpleType name="SmsStorageType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ME"/>
      <xs:enumeration value="SM"/>
      <xs:enumeration value="MT"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CallModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="command"/>
      <xs:enumeration value="ringing"/>
      <xs:enumeration value="dialing"/>
      <xs:enumeration value="online-data"/>
      <xs:enumeration value="online-command"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ModemLifecycleType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="READY"/>
      <xs:enumeration value="REBOOTING"/>
      <xs:enumeration value="FROZEN"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="FreezeModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NONE"/>
      <xs:enumeration value="NO_RESPONSE"/>
      <xs:enumeration value="HOLD_TX"/>
      <xs:enumeration value="HOLD_RX_TX"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CoverageStatusType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="implemented_full"/>
      <xs:enumeration value="implemented_stub"/>
      <xs:enumeration value="unsupported_declared"/>
      <xs:enumeration value="not_applicable"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RegisterNameType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="S0"/>
      <xs:enumeration value="S2"/>
      <xs:enumeration value="S3"/>
      <xs:enumeration value="S4"/>
      <xs:enumeration value="S5"/>
      <xs:enumeration value="S6"/>
      <xs:enumeration value="S7"/>
      <xs:enumeration value="S8"/>
      <xs:enumeration value="S12"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DeviationSeverityType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="info"/>
      <xs:enumeration value="warning"/>
      <xs:enumeration value="compatibility"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
