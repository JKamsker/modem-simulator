<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="modem-simulator">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="profile" type="ProfileType" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="ProfileType">
    <xs:sequence>
      <xs:element name="identity" type="IdentityType"/>
      <xs:element name="dialect" type="DialectType"/>
      <xs:element name="initial-state" type="InitialStateType"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:NCName" use="required"/>
    <xs:attribute name="extends" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="IdentityType">
    <xs:attribute name="manufacturer" type="xs:string" use="required"/>
    <xs:attribute name="model" type="xs:string" use="required"/>
    <xs:attribute name="revision" type="xs:string" use="optional"/>
    <xs:attribute name="imei" type="ImeiType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="DialectType">
    <xs:attribute name="commandTerminator" type="TerminatorType" use="required"/>
    <xs:attribute name="responseTerminator" type="TerminatorType" use="required"/>
    <xs:attribute name="smsPrompt" type="xs:string" use="optional"/>
    <xs:attribute name="defaultEcho" type="xs:boolean" use="optional"/>
    <xs:attribute name="defaultVerbose" type="xs:boolean" use="optional"/>
  </xs:complexType>

  <xs:complexType name="InitialStateType">
    <xs:sequence>
      <xs:element name="sim" type="SimType"/>
      <xs:element name="network" type="NetworkType"/>
      <xs:element name="signal" type="SignalType"/>
      <xs:element name="sms" type="SmsType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="SimType">
    <xs:attribute name="state" type="SimStateType" use="optional"/>
    <xs:attribute name="pinQueryEnabled" type="xs:boolean" use="required"/>
    <xs:attribute name="pin" type="PinType" use="optional"/>
    <xs:attribute name="pinRetries" type="RetryCounterType" use="optional"/>
    <xs:attribute name="pukRetries" type="RetryCounterType" use="optional"/>
    <xs:attribute name="imsi" type="ImsiType" use="optional"/>
    <xs:attribute name="iccid" type="IccidType" use="optional"/>
  </xs:complexType>

  <xs:complexType name="NetworkType">
    <xs:sequence>
      <xs:element name="operator" type="OperatorType" minOccurs="0"/>
      <xs:element name="sms-rate-limit" type="SmsRateLimitType" minOccurs="0"/>
      <xs:element name="delays" type="NetworkDelaysType" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="cregN" type="CregModeType" use="required"/>
    <xs:attribute name="stat" type="NetworkStatType" use="required"/>
    <xs:attribute name="lac" type="HexCellType" use="optional"/>
    <xs:attribute name="ci" type="HexCellType" use="optional"/>
    <xs:attribute name="act" type="AccessTechnologyType" use="optional"/>
    <xs:attribute name="rejectCause" type="xs:nonNegativeInteger" use="optional"/>
  </xs:complexType>

  <xs:complexType name="OperatorType">
    <xs:attribute name="selectionMode" type="OperatorSelectionModeType" use="required"/>
    <xs:attribute name="format" type="OperatorFormatType" use="required"/>
    <xs:attribute name="longName" type="xs:string" use="optional"/>
    <xs:attribute name="shortName" type="xs:string" use="optional"/>
    <xs:attribute name="numeric" type="OperatorNumericType" use="required"/>
    <xs:attribute name="mcc" type="MccType" use="required"/>
    <xs:attribute name="mnc" type="MncType" use="required"/>
  </xs:complexType>

  <xs:complexType name="SmsRateLimitType">
    <xs:attribute name="maxMessages" type="PositiveCounterType" use="required"/>
    <xs:attribute name="windowSeconds" type="PositiveCounterType" use="required"/>
    <xs:attribute name="scope" type="SmsRateLimitScopeType" use="required"/>
    <xs:attribute name="rejectCmsError" type="CmsErrorType" use="required"/>
  </xs:complexType>

  <xs:complexType name="NetworkDelaysType">
    <xs:sequence>
      <xs:element name="delay" type="NetworkDelayType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="NetworkDelayType">
    <xs:attribute name="operation" type="NetworkDelayOperationType" use="required"/>
    <xs:attribute name="minMs" type="xs:nonNegativeInteger" use="required"/>
    <xs:attribute name="maxMs" type="xs:nonNegativeInteger" use="required"/>
  </xs:complexType>

  <xs:complexType name="SignalType">
    <xs:attribute name="rssi" type="CsqValueType" use="required"/>
    <xs:attribute name="ber" type="CsqValueType" use="required"/>
  </xs:complexType>

  <xs:complexType name="SmsType">
    <xs:attribute name="textMode" type="xs:boolean" use="optional"/>
    <xs:attribute name="smsc" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:simpleType name="TerminatorType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="CR"/>
      <xs:enumeration value="LF"/>
      <xs:enumeration value="CRLF"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SimStateType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="READY"/>
      <xs:enumeration value="SIM_NOT_INSERTED"/>
      <xs:enumeration value="SIM_PIN_REQUIRED"/>
      <xs:enumeration value="SIM_PUK_REQUIRED"/>
      <xs:enumeration value="SIM_FAILURE"/>
      <xs:enumeration value="SIM_BUSY"/>
      <xs:enumeration value="SIM_WRONG"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PinType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4,8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RetryCounterType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="10"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PositiveCounterType">
    <xs:restriction base="xs:positiveInteger"/>
  </xs:simpleType>

  <xs:simpleType name="ImsiType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{14,15}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IccidType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{18,22}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ImeiType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{14,17}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CregModeType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="3"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NetworkStatType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="5"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HexCellType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9A-Fa-f]{1,8}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AccessTechnologyType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="9"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OperatorSelectionModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="automatic"/>
      <xs:enumeration value="manual"/>
      <xs:enumeration value="deregister"/>
      <xs:enumeration value="set-format"/>
      <xs:enumeration value="manual-automatic"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OperatorFormatType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="long"/>
      <xs:enumeration value="short"/>
      <xs:enumeration value="numeric"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SmsRateLimitScopeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="session"/>
      <xs:enumeration value="recipient"/>
      <xs:enumeration value="operator"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NetworkDelayOperationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="sms-submit"/>
      <xs:enumeration value="dial"/>
      <xs:enumeration value="network-registration"/>
      <xs:enumeration value="operator-read"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CmsErrorType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="999"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OperatorNumericType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{5,6}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MccType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MncType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{2,3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CsqValueType">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:maxInclusive value="99"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
