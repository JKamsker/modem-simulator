{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modem Simulator Event Log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "monotonicNanos",
    "sequence",
    "sessionId",
    "eventType",
    "source",
    "direction",
    "rawHex",
    "redaction",
    "profileHash",
    "configHash",
    "macroHash",
    "initialStateHash",
    "sessionSeed",
    "clockMode"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "monotonicNanos": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "string"
    },
    "portRole": {
      "enum": [
        "modem-simulation",
        "sniffer",
        "manual-dce-injection",
        "none"
      ]
    },
    "eventType": {
      "enum": [
        "SESSION_START",
        "SESSION_STOP",
        "RX_BYTES",
        "TX_BYTES",
        "PARSED_COMMAND",
        "PARSE_ERROR",
        "HANDLER_RESULT",
        "SCHEDULER_ENQUEUE",
        "SCHEDULER_EMIT",
        "STATE_CHANGE",
        "FAULT_TRIGGERED",
        "INJECTION",
        "MACRO_DECISION",
        "MACRO_EVENT",
        "POLICY_DENIED",
        "VALIDATION_ERROR",
        "REPLAY_MARKER",
        "PORT_OPEN_FAILED",
        "PORT_LOST",
        "RX_OVERFLOW",
        "TX_OVERFLOW",
        "DROPPED_EVENTS",
        "AUDIT_FAILURE"
      ]
    },
    "source": {
      "enum": [
        "rx",
        "tx",
        "gui",
        "macro",
        "replay",
        "scheduler",
        "transport",
        "internal"
      ]
    },
    "diagnosticCode": {
      "enum": [
        "PORT_NOT_FOUND",
        "PORT_BUSY",
        "PORT_PERMISSION_DENIED",
        "UNSUPPORTED_PARAMETERS",
        "PORT_LOST",
        "RX_OVERFLOW",
        "TX_OVERFLOW",
        "AUDIT_WRITE_FAILED",
        "POLICY_DENIED",
        "VALIDATION_ERROR"
      ]
    },
    "direction": {
      "enum": [
        "DTE_TO_DCE",
        "DCE_TO_DTE",
        "INTERNAL",
        "NONE"
      ]
    },
    "injectionType": {
      "enum": [
        "raw-dte-to-dce",
        "raw-dce-to-dte",
        "parsed-command",
        "state-change",
        "dtr-drop",
        "line-change",
        "scenario-step",
        "unknown-at-command-policy",
        "modem-reboot-complete",
        "macro-control",
        "replay"
      ]
    },
    "rawHex": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2})*$|^<redacted>$"
    },
    "textEscaped": {
      "type": [
        "string",
        "null"
      ]
    },
    "parsedCommand": {
      "type": [
        "object",
        "null"
      ]
    },
    "profile": {
      "type": "string"
    },
    "profileHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "macroHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "initialStateHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionSeed": {
      "type": "integer"
    },
    "clockMode": {
      "enum": [
        "virtual",
        "monotonic"
      ]
    },
    "macroId": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    },
    "handler": {
      "type": [
        "string",
        "null"
      ]
    },
    "latencyMs": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dueMonotonicNanos",
        "sourceSequence",
        "sourcePriority",
        "stateVersion",
        "cancelOnStateChange",
        "operation",
        "sampledDelayMs",
        "cancelled"
      ],
      "properties": {
        "dueMonotonicNanos": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSequence": {
          "type": "integer",
          "minimum": 0
        },
        "sourcePriority": {
          "enum": [
            "internal",
            "replay",
            "rx",
            "gui",
            "macro"
          ]
        },
        "stateVersion": {
          "type": "integer",
          "minimum": 0
        },
        "cancelOnStateChange": {
          "type": "boolean"
        },
        "sampledDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string"
        },
        "cancelled": {
          "type": "boolean"
        }
      }
    },
    "stateBefore": {
      "type": [
        "object",
        "null"
      ]
    },
    "stateAfter": {
      "type": [
        "object",
        "null"
      ]
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "policy",
        "fields",
        "classes"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "policy": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "enum": [
              "pin",
              "puk",
              "imsi",
              "iccid",
              "imei",
              "msisdn",
              "sms-body"
            ]
          }
        }
      }
    },
    "droppedEventCount": {
      "type": "integer",
      "minimum": 0
    },
    "replayDivergent": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "SCHEDULER_ENQUEUE",
              "SCHEDULER_EMIT"
            ]
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "scheduler"
        ],
        "properties": {
          "source": {
            "const": "scheduler"
          },
          "direction": {
            "const": "INTERNAL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "SESSION_START",
              "SESSION_STOP",
              "STATE_CHANGE",
              "FAULT_TRIGGERED"
            ]
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "internal"
          },
          "direction": {
            "const": "INTERNAL"
          },
          "rawHex": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "INJECTION"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "enum": [
              "gui",
              "replay",
              "internal"
            ]
          },
          "direction": {
            "enum": [
              "DTE_TO_DCE",
              "DCE_TO_DTE",
              "INTERNAL"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "MACRO_DECISION",
              "MACRO_EVENT"
            ]
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "macro"
          },
          "direction": {
            "const": "INTERNAL"
          },
          "rawHex": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "REPLAY_MARKER"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "replay"
          },
          "direction": {
            "const": "INTERNAL"
          },
          "rawHex": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "POLICY_DENIED",
              "VALIDATION_ERROR"
            ]
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "internal"
          },
          "direction": {
            "const": "INTERNAL"
          },
          "rawHex": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "RX_BYTES"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "rx"
          },
          "direction": {
            "const": "DTE_TO_DCE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "TX_BYTES"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "tx"
          },
          "direction": {
            "const": "DCE_TO_DTE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "enum": [
              "PARSED_COMMAND",
              "PARSE_ERROR",
              "HANDLER_RESULT"
            ]
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "properties": {
          "source": {
            "const": "internal"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "PORT_OPEN_FAILED"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "diagnosticCode",
          "port",
          "portRole"
        ],
        "properties": {
          "source": {
            "const": "transport"
          },
          "direction": {
            "enum": [
              "INTERNAL",
              "NONE"
            ]
          },
          "rawHex": {
            "const": ""
          },
          "diagnosticCode": {
            "enum": [
              "PORT_NOT_FOUND",
              "PORT_BUSY",
              "PORT_PERMISSION_DENIED",
              "UNSUPPORTED_PARAMETERS"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "PORT_LOST"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "diagnosticCode"
        ],
        "properties": {
          "source": {
            "const": "transport"
          },
          "diagnosticCode": {
            "const": "PORT_LOST"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "RX_OVERFLOW"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "diagnosticCode",
          "replayDivergent"
        ],
        "properties": {
          "source": {
            "const": "transport"
          },
          "diagnosticCode": {
            "const": "RX_OVERFLOW"
          },
          "replayDivergent": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "TX_OVERFLOW"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "diagnosticCode",
          "replayDivergent"
        ],
        "properties": {
          "source": {
            "const": "transport"
          },
          "diagnosticCode": {
            "const": "TX_OVERFLOW"
          },
          "replayDivergent": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "DROPPED_EVENTS"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "droppedEventCount"
        ],
        "properties": {
          "source": {
            "const": "internal"
          },
          "direction": {
            "const": "NONE"
          },
          "rawHex": {
            "const": ""
          },
          "droppedEventCount": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "AUDIT_FAILURE"
          }
        },
        "required": [
          "eventType"
        ]
      },
      "then": {
        "required": [
          "diagnosticCode"
        ],
        "properties": {
          "source": {
            "const": "internal"
          },
          "diagnosticCode": {
            "const": "AUDIT_WRITE_FAILED"
          }
        }
      }
    }
  ]
}
