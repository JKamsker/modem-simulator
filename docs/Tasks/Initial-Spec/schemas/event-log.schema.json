{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modem Simulator Event Log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "monotonicNanos",
    "sequence",
    "sessionId",
    "eventType",
    "direction",
    "rawHex",
    "redaction",
    "profileHash",
    "configHash",
    "macroHash",
    "initialStateHash",
    "sessionSeed",
    "clockMode"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "monotonicNanos": {
      "type": "integer",
      "minimum": 0
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "string"
    },
    "portRole": {
      "enum": [
        "modem-simulation",
        "sniffer",
        "manual-dce-injection",
        "none"
      ]
    },
    "eventType": {
      "enum": [
        "SESSION_START",
        "SESSION_STOP",
        "RX_BYTES",
        "TX_BYTES",
        "PARSED_COMMAND",
        "HANDLER_RESULT",
        "SCHEDULER_ENQUEUE",
        "SCHEDULER_EMIT",
        "STATE_CHANGE",
        "FAULT_TRIGGERED",
        "INJECTION",
        "MACRO_DECISION",
        "MACRO_EVENT",
        "REPLAY_MARKER",
        "PORT_LOST",
        "RX_OVERFLOW",
        "TX_OVERFLOW",
        "AUDIT_FAILURE"
      ]
    },
    "direction": {
      "enum": [
        "DTE_TO_DCE",
        "DCE_TO_DTE",
        "INTERNAL",
        "NONE"
      ]
    },
    "injectionType": {
      "enum": [
        "raw-dte-to-dce",
        "raw-dce-to-dte",
        "parsed-command",
        "state-change",
        "dtr-drop",
        "line-change",
        "scenario-step",
        "unknown-at-command-policy",
        "modem-reboot-complete",
        "macro-control",
        "replay"
      ]
    },
    "rawHex": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2})*$|^<redacted>$"
    },
    "textEscaped": {
      "type": [
        "string",
        "null"
      ]
    },
    "parsedCommand": {
      "type": [
        "object",
        "null"
      ]
    },
    "profile": {
      "type": "string"
    },
    "profileHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "configHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "macroHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "initialStateHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionSeed": {
      "type": "integer"
    },
    "clockMode": {
      "enum": [
        "virtual",
        "monotonic"
      ]
    },
    "macroId": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    },
    "handler": {
      "type": [
        "string",
        "null"
      ]
    },
    "latencyMs": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dueMonotonicNanos": {
          "type": "integer",
          "minimum": 0
        },
        "sourceSequence": {
          "type": "integer",
          "minimum": 0
        },
        "sourcePriority": {
          "enum": [
            "rx",
            "gui",
            "macro",
            "replay",
            "internal"
          ]
        },
        "sampledDelayMs": {
          "type": "integer",
          "minimum": 0
        },
        "operation": {
          "type": "string"
        },
        "cancelled": {
          "type": "boolean"
        }
      }
    },
    "stateBefore": {
      "type": [
        "object",
        "null"
      ]
    },
    "stateAfter": {
      "type": [
        "object",
        "null"
      ]
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applied",
        "policy",
        "fields",
        "classes"
      ],
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "policy": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "classes": {
          "type": "array",
          "items": {
            "enum": [
              "pin",
              "puk",
              "imsi",
              "iccid",
              "imei",
              "msisdn",
              "sms-body"
            ]
          }
        }
      }
    },
    "droppedEventCount": {
      "type": "integer",
      "minimum": 0
    },
    "replayDivergent": {
      "type": "boolean"
    }
  }
}
