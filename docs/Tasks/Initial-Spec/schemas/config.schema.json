{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Modem Simulator Config",
  "description": "Schema for config.yaml after YAML parsing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ports",
    "serialLine",
    "sessionSeed",
    "redaction"
  ],
  "allOf": [
    {
      "properties": {
        "ports": {
          "contains": {
            "type": "object",
            "required": [
              "role",
              "enabled",
              "profile"
            ],
            "properties": {
              "role": {
                "const": "modem-simulation"
              },
              "enabled": {
                "const": true
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "ports": {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "sniffer"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "ports": {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "manual-dce-injection"
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      }
    }
  ],
  "properties": {
    "sessionSeed": {
      "type": "integer"
    },
    "clockMode": {
      "enum": [
        "virtual",
        "monotonic"
      ],
      "default": "monotonic"
    },
    "strictOptionalPorts": {
      "type": "boolean",
      "default": false
    },
    "serialLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baudRate",
        "dataBits",
        "stopBits",
        "parity",
        "flowControl"
      ],
      "properties": {
        "baudRate": {
          "type": "integer",
          "minimum": 1
        },
        "dataBits": {
          "enum": [
            5,
            6,
            7,
            8
          ]
        },
        "stopBits": {
          "enum": [
            1,
            2
          ]
        },
        "parity": {
          "enum": [
            "NONE",
            "EVEN",
            "ODD",
            "MARK",
            "SPACE"
          ]
        },
        "flowControl": {
          "enum": [
            "NONE",
            "RTS_CTS",
            "XON_XOFF"
          ]
        }
      }
    },
    "ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "role",
          "enabled"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "modem-simulation"
                }
              },
              "required": [
                "role"
              ]
            },
            "then": {
              "required": [
                "profile"
              ],
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            }
          }
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "serial",
              "headless"
            ]
          },
          "role": {
            "enum": [
              "modem-simulation",
              "sniffer",
              "manual-dce-injection"
            ]
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "profile": {
            "type": "string"
          },
          "initialScenario": {
            "type": "string"
          },
          "snifferFormat": {
            "enum": [
              "tagged-text",
              "jsonl-events",
              "raw-dte",
              "raw-dce",
              "raw-both"
            ],
            "default": "tagged-text"
          },
          "virtualComTool": {
            "enum": [
              "com0com",
              "socat-pty",
              "tty0tty",
              "os-device"
            ]
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maskPin",
        "maskPuk",
        "maskImsi",
        "maskIccid",
        "maskImei",
        "maskMsisdn",
        "maskSmsBody"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "maskPin": {
          "const": true
        },
        "maskPuk": {
          "const": true
        },
        "maskImsi": {
          "const": true
        },
        "maskIccid": {
          "const": true
        },
        "maskImei": {
          "const": true
        },
        "maskMsisdn": {
          "const": true
        },
        "maskSmsBody": {
          "const": true
        }
      }
    },
    "gui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readOnly": {
          "type": "boolean",
          "default": false
        },
        "allowUnsafeDceTransmit": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "errorPolicy": {
      "type": "object"
    }
  }
}
