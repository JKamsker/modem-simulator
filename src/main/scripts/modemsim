#!/usr/bin/env sh
set -eu

APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
JAVA_EXE=${JAVA_HOME:+$JAVA_HOME/bin/java}
JAVA_EXE=${JAVA_EXE:-java}

exec "$JAVA_EXE" \
  --enable-native-access=ALL-UNNAMED \
  -Dmodemsim.home="$APP_HOME" \
  ${MODEMSIM_JAVA_OPTS:-} \
  -cp "$APP_HOME/lib/*" \
  com.jkamsker.modemsim.app.ModemSimCli "$@"
